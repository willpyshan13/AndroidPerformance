{
  "name": "android-performance-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "author": {
    "name": "Android Performance Workbench",
    "email": "willpyshan13@users.noreply.github.com",
    "url": "https://github.com/willpyshan13/AndroidPerformance"
  },
  "description": "Local-first Android performance workbench powered by ADB",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron .",
    "package:mac": "electron-builder --mac dir --arm64 --publish never --config.electronDist=node_modules/electron/dist",
    "prepare:desktop-tools": "node scripts/prepare-sdk-tools.js",
    "smoke:apk-tools": "node scripts/apk-tools-smoke.js",
    "test": "node --test --test-concurrency=1",
    "benchmark:cli": "node src/benchmark-cli.js",
    "benchmark:cpu-visualization": "node scripts/benchmark-cpu-visualization.js",
    "test:device": "node scripts/device-smoke.js",
    "build:hprof-load-fixture": "node scripts/build-hprof-load-fixture.js",
    "prepare:perfetto-ui": "node scripts/prepare-perfetto-ui.js",
    "check": "node --check src/native-symbolizer.js && node --check scripts/prepare-native-symbolizer.js && node --check scripts/native-symbolizer-smoke.js && node --check src/server.js && node --check src/macrobenchmark.js && node --check src/benchmark-cli.js && node --check src/adb.js && node --check src/simpleperf-diagnostics.js && node --check src/parsers.js && node --check src/records.js && node --check desktop/main.js && node --check desktop/menu.js && node --check desktop/locale.js && node --check desktop/preload.cjs && node --check public/app.js && node --check public/heap-export.js && node --check public/trace-export.js && node --check public/shark-export.js && node --check public/binder-export.js && node --check public/startup-export.js && node --check public/i18n.js && node --check public/offline.js && node --check public/art-trace-worker.js && node --check public/demo.js && node --check src/apk.js && node --check src/apk-signatures.js && node --check src/apk-upload.js && node --check src/perf-upload.js && node --check src/simpleperf.js && node --check src/hprof.js && node --check src/hprof-upload.js && node --check src/shark.js && node --check src/java-runtime.js && node --check scripts/prepare-apk-tools.js && node --check scripts/prepare-linux-arm64-tools.js && node --check scripts/apk-tools-smoke.js && node --check scripts/linux-arm64-package-smoke.js && node --check scripts/floor-linux-arm64-deb-glibc.js && node --check scripts/prepare-sdk-tools.js && node --check scripts/diagnose-tests.js && node --check scripts/run-npm-task.js && node --check scripts/desktop-smoke.js && node --check scripts/mac-desktop-smoke.js && node --check scripts/prepare-simpleperf.js && node --check scripts/prepare-python-runtime.js && node --check scripts/prepare-inspector-runtime.js && node --check scripts/prepare-trace-processor.js && node --check src/trace-processor-artifacts.js && node --check scripts/prepare-perfetto-ui.js && node --check scripts/prepare-shark.js && node --check scripts/prepare-ui-inspector.js && node --check src/compose-inspector.js && node --check src/trace-analysis.js && node --check src/battery.js && node --check src/gpu.js && node --check src/dominators.js && node --check src/preferences.js && node --check src/source-workspace.js && node --check src/source-symbols.js && node --check src/source-git.js && node --check src/network-agent.js && node --check src/network-agent-socket.js && node --check src/layout-agent.js && node --check src/agent-package.js && node --check src/agent-injection.js && node --check src/compose-runtime.js && node --check src/leakcanary-live.js && node --check src/jankstats-agent.js && node --check scripts/benchmark-cpu-visualization.js && node --check scripts/device-smoke.js && node --check scripts/build-hprof-load-fixture.js",
    "prepare:adb": "bash scripts/prepare-adb.sh",
    "prepare:apk-tools": "node scripts/prepare-apk-tools.js",
    "prepare:simpleperf": "node scripts/prepare-simpleperf.js && node scripts/prepare-python-runtime.js",
    "prepare:trace-processor": "node scripts/prepare-trace-processor.js",
    "prepare:shark": "node scripts/prepare-shark.js",
    "prepare:inspector-runtime": "node scripts/prepare-inspector-runtime.js",
    "prepare:ui-inspector": "node scripts/prepare-ui-inspector.js",
    "prepare:native-symbolizer": "node scripts/prepare-native-symbolizer.js",
    "smoke:native-symbolizer": "node scripts/native-symbolizer-smoke.js"
  },
  "build": {
    "appId": "dev.androidperformance.workbench",
    "productName": "Android Performance",
    "asar": true,
    "extraResources": [
      {
        "from": "tools/perfetto-ui",
        "to": "perfetto-ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/shark-cli",
        "to": "shark-cli",
        "filter": [
          "**/*.jar",
          "licenses/**",
          "NOTICE.txt",
          "source.json"
        ]
      },
      {
        "from": "tools/ui-inspector",
        "to": "ui-inspector",
        "filter": [
          "classpath.json",
          "lib/**",
          "licenses/**",
          "DEPENDENCIES.md",
          "LICENSE-2.0.txt",
          "NOTICE.txt",
          "source.json"
        ]
      }
    ],
    "directories": {
      "output": "dist/v${version}",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.js",
      "desktop/menu.js",
      "desktop/locale.js",
      "desktop/preload.cjs",
      "desktop/resources/icon.png",
      "src/**",
      "public/**",
      "package.json",
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/LAYOUT_AGENT_README.md",
      "android-agent/LEAKCANARY_AGENT_README.md",
      "android-agent/JANKSTATS_AGENT_README.md",
      "android-agent/src/**",
      "android-agent/optional-androidx/**",
      "android-agent/optional-jankstats/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/resources/icon.png",
      "identity": "-",
      "extraResources": [
        {
          "from": "tools/java-runtime",
          "to": "java-runtime"
        },
        {
          "from": "tools/java25-runtime",
          "to": "java25-runtime"
        },
        {
          "from": "tools/platform-tools",
          "to": "platform-tools",
          "filter": [
            "adb",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/apk-tools",
          "to": "apk-tools",
          "filter": [
            "aapt2",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/simpleperf",
          "to": "simpleperf",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "tools/trace-processor",
          "to": "trace-processor"
        },
        {
          "from": "tools/native-symbolizer",
          "to": "native-symbolizer",
          "filter": [
            "llvm-symbolizer",
            "NOTICE*",
            "MODULE_LICENSE_*",
            "source.json"
          ]
        }
      ]
    },
    "win": {
      "icon": "desktop/resources/icon.png",
      "target": "nsis",
      "extraResources": [
        {
          "from": "tools/perfetto-ui",
          "to": "perfetto-ui",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/shark-cli",
          "to": "shark-cli",
          "filter": [
            "**/*.jar",
            "licenses/**",
            "NOTICE.txt",
            "source.json"
          ]
        },
        {
          "from": "tools/java-runtime.tar.gz",
          "to": "java-runtime.tar.gz"
        },
        {
          "from": "tools/simpleperf",
          "to": "simpleperf",
          "filter": [
            "**/*",
            "!bin/darwin/**",
            "!bin/linux/**",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "tools/ui-inspector",
          "to": "ui-inspector",
          "filter": [
            "classpath.json",
            "lib/**",
            "licenses/**",
            "DEPENDENCIES.md",
            "LICENSE-2.0.txt",
            "NOTICE.txt",
            "source.json"
          ]
        },
        {
          "from": "tools/platform-tools",
          "to": "platform-tools",
          "filter": [
            "adb.exe",
            "AdbWin*.dll",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/apk-tools",
          "to": "apk-tools",
          "filter": [
            "aapt2.exe",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/trace-processor",
          "to": "trace-processor",
          "filter": [
            "trace_processor_shell.exe",
            "LICENSE",
            "source.json"
          ]
        }
      ]
    },
    "linux": {
      "icon": "desktop/resources/icon.png",
      "category": "Development",
      "target": "AppImage",
      "extraResources": [
        {
          "from": "tools/perfetto-ui",
          "to": "perfetto-ui",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/shark-cli",
          "to": "shark-cli",
          "filter": [
            "**/*.jar",
            "licenses/**",
            "NOTICE.txt",
            "source.json"
          ]
        },
        {
          "from": "tools/java-runtime",
          "to": "java-runtime"
        },
        {
          "from": "tools/simpleperf",
          "to": "simpleperf",
          "filter": [
            "**/*",
            "!bin/darwin/**",
            "!bin/windows/**",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "tools/ui-inspector",
          "to": "ui-inspector",
          "filter": [
            "classpath.json",
            "lib/**",
            "licenses/**",
            "DEPENDENCIES.md",
            "LICENSE-2.0.txt",
            "NOTICE.txt",
            "source.json"
          ]
        },
        {
          "from": "tools/platform-tools",
          "to": "platform-tools",
          "filter": [
            "adb",
            "adb.bin",
            "lib/**",
            "licenses/**",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/apk-tools",
          "to": "apk-tools",
          "filter": [
            "aapt2",
            "aapt2.bin",
            "lib/**",
            "licenses/**",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/trace-processor",
          "to": "trace-processor",
          "filter": [
            "trace_processor_shell",
            "LICENSE",
            "source.json"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/LAYOUT_AGENT_README.md",
      "android-agent/LEAKCANARY_AGENT_README.md",
      "android-agent/src/**",
      "android-agent/optional-androidx/**",
      "android-agent/optional-jankstats/**"
    ]
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
