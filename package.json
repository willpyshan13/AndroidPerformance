{
  "name": "android-performance-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "author": "Android Performance Workbench",
  "description": "Local-first Android performance workbench powered by ADB",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron .",
    "package:mac": "electron-builder --mac dir --arm64",
    "package:dmg": "electron-builder --mac dmg --arm64",
    "package:win": "electron-builder --win nsis --x64",
    "package:linux": "electron-builder --linux AppImage",
    "test": "node --test",
    "test:device": "node scripts/device-smoke.js",
    "check": "node --check src/server.js && node --check src/adb.js && node --check src/parsers.js && node --check src/records.js && node --check desktop/main.js && node --check desktop/preload.cjs && node --check public/app.js && node --check public/offline.js && node --check public/demo.js && node --check src/apk.js && node --check src/apk-signatures.js && node --check src/apk-upload.js && node --check src/perf-upload.js && node --check src/simpleperf.js && node --check src/hprof.js && node --check src/hprof-upload.js && node --check src/hprof-worker.js && node --check scripts/prepare-apk-tools.js && node --check scripts/prepare-simpleperf.js && node --check scripts/prepare-trace-processor.js && node --check src/trace-analysis.js && node --check src/battery.js && node --check src/gpu.js && node --check src/dominators.js && node --check src/source-workspace.js && node --check src/source-symbols.js && node --check src/source-git.js && node --check src/network-agent.js && node --check src/agent-package.js",
    "prepare:adb": "bash scripts/prepare-adb.sh",
    "prepare:apk-tools": "node scripts/prepare-apk-tools.js",
    "prepare:simpleperf": "node scripts/prepare-simpleperf.js",
    "prepare:trace-processor": "node scripts/prepare-trace-processor.js"
  },
  "build": {
    "appId": "dev.androidperformance.workbench",
    "productName": "Android Performance",
    "asar": true,
    "directories": {
      "output": "dist/v${version}",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.js",
      "desktop/preload.cjs",
      "desktop/resources/icon.png",
      "src/**",
      "public/**",
      "package.json",
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/src/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/resources/icon.png",
      "identity": "-",
      "extraResources": [
        {
          "from": "tools/platform-tools",
          "to": "platform-tools",
          "filter": [
            "adb",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/apk-tools",
          "to": "apk-tools",
          "filter": [
            "aapt2",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/simpleperf",
          "to": "simpleperf",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "tools/trace-processor",
          "to": "trace-processor"
        }
      ]
    },
    "win": {
      "icon": "desktop/resources/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "desktop/resources/icon.png",
      "category": "Development",
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/src/**"
    ]
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
