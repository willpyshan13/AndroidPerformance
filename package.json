{
  "name": "android-performance-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "author": {
    "name": "Android Performance Workbench",
    "email": "willpyshan13@users.noreply.github.com",
    "url": "https://github.com/willpyshan13/AndroidPerformance"
  },
  "description": "Local-first Android performance workbench powered by ADB",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron .",
    "package:mac": "electron-builder --mac dir --arm64 --publish never",
    "package:mac:installers": "electron-builder --mac dmg pkg --arm64 --publish never",
    "package:mac:installers:x64": "electron-builder --mac dmg pkg --x64 --publish never",
    "package:dmg": "electron-builder --mac dmg --arm64 --publish never",
    "package:dmg:x64": "electron-builder --mac dmg --x64 --publish never",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:win:installers": "electron-builder --win nsis msi --x64 --publish never",
    "package:linux": "electron-builder --linux AppImage --publish never",
    "package:linux:installers": "electron-builder --linux AppImage deb rpm --publish never",
    "package:linux:arm64": "electron-builder --linux AppImage --arm64 --publish never",
    "prepare:desktop-tools": "node scripts/prepare-sdk-tools.js",
    "test": "node --test",
    "benchmark:cpu-visualization": "node scripts/benchmark-cpu-visualization.js",
    "test:device": "node scripts/device-smoke.js",
    "prepare:perfetto-ui": "node scripts/prepare-perfetto-ui.js",
    "check": "node --check src/server.js && node --check src/macrobenchmark.js && node --check src/adb.js && node --check src/simpleperf-diagnostics.js && node --check src/parsers.js && node --check src/records.js && node --check desktop/main.js && node --check desktop/menu.js && node --check desktop/locale.js && node --check desktop/preload.cjs && node --check public/app.js && node --check public/i18n.js && node --check public/offline.js && node --check public/demo.js && node --check src/apk.js && node --check src/apk-signatures.js && node --check src/apk-upload.js && node --check src/perf-upload.js && node --check src/simpleperf.js && node --check src/hprof.js && node --check src/hprof-upload.js && node --check src/hprof-worker.js && node --check src/shark.js && node --check src/java-runtime.js && node --check scripts/prepare-apk-tools.js && node --check scripts/prepare-sdk-tools.js && node --check scripts/diagnose-tests.js && node --check scripts/run-npm-task.js && node --check scripts/desktop-smoke.js && node --check scripts/mac-desktop-smoke.js && node --check scripts/prepare-simpleperf.js && node --check scripts/prepare-trace-processor.js && node --check src/trace-processor-artifacts.js && node --check scripts/prepare-perfetto-ui.js && node --check scripts/prepare-shark.js && node --check scripts/prepare-ui-inspector.js && node --check src/compose-inspector.js && node --check src/trace-analysis.js && node --check src/battery.js && node --check src/gpu.js && node --check src/dominators.js && node --check src/preferences.js && node --check src/source-workspace.js && node --check src/source-symbols.js && node --check src/source-git.js && node --check src/network-agent.js && node --check src/layout-agent.js && node --check src/agent-package.js && node --check src/compose-runtime.js && node --check src/leakcanary-live.js && node --check scripts/benchmark-cpu-visualization.js",
    "prepare:adb": "bash scripts/prepare-adb.sh",
    "prepare:apk-tools": "node scripts/prepare-apk-tools.js",
    "prepare:simpleperf": "node scripts/prepare-simpleperf.js",
    "prepare:trace-processor": "node scripts/prepare-trace-processor.js",
    "prepare:shark": "node scripts/prepare-shark.js",
    "prepare:ui-inspector": "node scripts/prepare-ui-inspector.js"
  },
  "build": {
    "appId": "dev.androidperformance.workbench",
    "productName": "Android Performance",
    "asar": true,
    "extraResources": [
      {
        "from": "tools/perfetto-ui",
        "to": "perfetto-ui",
        "filter": ["**/*"]
      },
      {
        "from": "tools/shark-cli",
        "to": "shark-cli",
        "filter": ["**/*.jar", "licenses/**", "NOTICE.txt", "source.json"]
      },
      {
        "from": "tools/ui-inspector",
        "to": "ui-inspector",
        "filter": ["classpath.json", "lib/**", "licenses/**", "DEPENDENCIES.md", "LICENSE-2.0.txt", "NOTICE.txt", "source.json"]
      }
    ],
    "directories": {
      "output": "dist/v${version}",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.js",
      "desktop/menu.js",
      "desktop/locale.js",
      "desktop/preload.cjs",
      "desktop/resources/icon.png",
      "src/**",
      "public/**",
      "package.json",
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/LAYOUT_AGENT_README.md",
      "android-agent/src/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/resources/icon.png",
      "identity": "-",
      "extraResources": [
        { "from": "tools/java-runtime", "to": "java-runtime" },
        {
          "from": "tools/platform-tools",
          "to": "platform-tools",
          "filter": [
            "adb",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/apk-tools",
          "to": "apk-tools",
          "filter": [
            "aapt2",
            "NOTICE.txt",
            "source.properties"
          ]
        },
        {
          "from": "tools/simpleperf",
          "to": "simpleperf",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "tools/trace-processor",
          "to": "trace-processor"
        }
      ]
    },
    "win": {
      "icon": "desktop/resources/icon.png",
      "target": "nsis",
      "extraResources": [
        { "from": "tools/perfetto-ui", "to": "perfetto-ui", "filter": ["**/*"] },
        { "from": "tools/shark-cli", "to": "shark-cli", "filter": ["**/*.jar", "licenses/**", "NOTICE.txt", "source.json"] },
        { "from": "tools/java-runtime.tar.gz", "to": "java-runtime.tar.gz" },
        { "from": "tools/ui-inspector", "to": "ui-inspector", "filter": ["classpath.json", "lib/**", "licenses/**", "DEPENDENCIES.md", "LICENSE-2.0.txt", "NOTICE.txt", "source.json"] },
        { "from": "tools/platform-tools", "to": "platform-tools", "filter": ["adb.exe", "AdbWin*.dll", "NOTICE.txt", "source.properties"] },
        { "from": "tools/apk-tools", "to": "apk-tools", "filter": ["aapt2.exe", "NOTICE.txt", "source.properties"] },
        { "from": "tools/trace-processor", "to": "trace-processor", "filter": ["trace_processor_shell.exe", "LICENSE", "source.json"] }
      ]
    },
    "linux": {
      "icon": "desktop/resources/icon.png",
      "category": "Development",
      "target": "AppImage",
      "extraResources": [
        { "from": "tools/perfetto-ui", "to": "perfetto-ui", "filter": ["**/*"] },
        { "from": "tools/shark-cli", "to": "shark-cli", "filter": ["**/*.jar", "licenses/**", "NOTICE.txt", "source.json"] },
        { "from": "tools/java-runtime", "to": "java-runtime" },
        { "from": "tools/ui-inspector", "to": "ui-inspector", "filter": ["classpath.json", "lib/**", "licenses/**", "DEPENDENCIES.md", "LICENSE-2.0.txt", "NOTICE.txt", "source.json"] },
        { "from": "tools/platform-tools", "to": "platform-tools", "filter": ["adb", "NOTICE.txt", "source.properties"] },
        { "from": "tools/apk-tools", "to": "apk-tools", "filter": ["aapt2", "NOTICE.txt", "source.properties"] },
        { "from": "tools/trace-processor", "to": "trace-processor", "filter": ["trace_processor_shell", "LICENSE", "source.json"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "scripts/simpleperf-timeline.py",
      "scripts/simpleperf-collapse.py",
      "scripts/simpleperf_format.py",
      "android-agent/README.md",
      "android-agent/LAYOUT_AGENT_README.md",
      "android-agent/src/**"
    ]
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
